# Copy to .env (root, for docker compose) or apps/api/.env (for a local
# `nx serve api` run) and adjust. Never commit the real file.
#
# Exodex talks to a public, unauthenticated NASA endpoint, so there is no API
# key to configure here. Nothing in this repository reads an API_KEY variable.

# Frontend origin allowed for CORS (code default: https://exodex.zemios.dev)
CORS_ORIGIN=https://exodex.zemios.dev

# API port (default: 3000)
PORT=3000

# NASA TAP API endpoint (optional, has default)
NASA_TAP_BASE_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync

# Disk cache TTL in hours (default: 24). Data is loaded from file if younger than this.
DISK_CACHE_TTL_HOURS=24

# Path to the disk cache file (default: ./data/exoplanets-cache.json)
# DISK_CACHE_PATH=./data/exoplanets-cache.json

# In-memory refresh interval in seconds (default: 3600). Triggers a re-check against disk cache.
CACHE_TTL_SECONDS=3600

# Rate limiting (defaults: 120 requests per 60s, per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120