{
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "gitignore": true,
  "crossFormats": [["javascript", "typescript"]],
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/_node_modules_junction/**",
    "**/.nx/**",
    "**/.angular/**",
    "**/jscpd-report/**",
    "**/report/**",
    "**/openspec/**",
    "**/.agents/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/tsconfig*.json",
    "**/eslint.config.mjs",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__snapshots__/**"
  ],
  "baseline": ".jscpd-baseline.json",
  "output": "jscpd-report",
  "failOnNewClones": 0,
  "failOnEmpty": true,
  "reporters": ["console", "json", "markdown"]
}
